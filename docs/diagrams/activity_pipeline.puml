@startuml activity_pipeline
skinparam defaultFontName Arial
start
:Загрузка: чтение CSV порции, приведение типов;
:Проверка схемы и ResponseId (DQ-1, DQ-2),
доли неизвестных категорий (DQ-7);
if (Есть ошибки?) then (да)
  :Отчёт о проверке, порция отклонена;
  stop
else (нет)
endif
:Отбор: MainBranch = профессионал,
Employment = Employed;
:Очистка: убрать пустые анкеты (DQ-3),
доход вне [1 000; 1 000 000] USD (DQ-4),
невозможный стаж заменить пропуском (DQ-5, DQ-6);
if (Режим?) then (обучение)
  :Оценить параметры на обучающих данных:
  медианы, словари категорий, индекс страны,
  StandardScaler, PCA;
  :Сохранить параметры (joblib, DVC);
else (новая порция)
  :Загрузить сохранённые параметры;
endif
:Формирование признаков: порядковое кодирование,
индикаторы языков, заполнение пропусков,
новые признаки, log10 дохода;
:Сохранение таблицы признаков (Parquet);
if (Режим?) then (обучение)
  :Обучение модели, запись в MLflow;
else (новая порция)
  :Прогноз и пересчёт показателей;
endif
stop
@enduml
